# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=supertokens
MYSQL_USER=supertokens_user
MYSQL_PASSWORD=your_secure_password_here

# SuperTokens Configuration
# API key must be at least 20 characters and only contain alphanumeric characters, '=' and '-'
SUPERTOKENS_API_KEYS=your-supertokens-api-key-at-least-20-chars

# OAuth Provider Configurations

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth
# Note: Store the .p8 key file in a secure location accessible by your application
# For Docker deployments, mount the key file as a volume or use Docker secrets
APPLE_CLIENT_ID=your.apple.service.id
APPLE_KEY_ID=your_apple_key_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_KEYID.p8

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Twitter (X) OAuth
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# Application URLs
APP_URL=http://localhost:3000
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
